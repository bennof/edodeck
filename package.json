{
  "name": "edodeck",
  "version": "0.0.1",
  "description": "Presentation library: an HTML/CSS/JS slide deck that can be embedded into any document via <script>+<link>.",
  "type": "module",
  "main": "dist/edodeck.esm.js",
  "module": "dist/edodeck.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "node esbuild.config.mjs --minify && tsc --project tsconfig.build.json",
    "watch": "node esbuild.config.mjs --watch",
    "dev": "node esbuild.config.mjs --watch --serve",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "Benjamin Benno Falkner <bennof@falkner.xyz>",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2"
  }
}
